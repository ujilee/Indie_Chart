# 이 파일을 복사해 같은 폴더에 .env.local 로 저장하고 값을 채우세요. (.env.local은 깃허브에 올라가지 않아요)
#   cp .env.example .env.local

# ── Supabase (Project Settings → API) ──
# URL과 SERVICE_ROLE_KEY가 있으면 자동으로 supabase(운영 DB) 모드가 돼요. 비우면 로컬 파일(.data/db.json)에 저장해요.
SUPABASE_URL=
# 공개용(Publishable) 키: 회원 로그인에 쓴다 (sb_publishable_…)
SUPABASE_PUBLISHABLE_KEY=
# 소셜 로그인: Supabase → Authentication → Providers에서 켠 것만 쉼표로 (kakao,google). 비우면 버튼이 '준비 중'으로 보여요
SUPABASE_OAUTH_PROVIDERS=
# service_role 키(비밀). 서버에서만 쓰고 브라우저로 보내지 않아요. 절대 공개하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ── 로그인 세션 서명 (운영 필수, 아무 긴 임의 문자열) ──
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── 멜론 자동 수집 (운영 DB 모드는 기본 꺼짐. 제휴·허가 후 1로) ──
MELON_AUTO_COLLECT=

# ── 예약 수집 (Vercel Cron이 이 값으로 /api/cron/melon 을 호출) ──
CRON_SECRET=

# ── Spotify 공식 API (선택: 프로필 이미지, 팔로워) ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── 관리자 앱에서 사용자 서비스로 가는 링크 ──
NEXT_PUBLIC_WEB_URL=http://localhost:3000
